# Copy this file to .env. Keep credentials private and out of version control.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional live provider evidence.
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
VEXCEL_API_KEY=

# Optional catalog paths. Directories under COSTAR_DATA_DIR contain
# commercial-properties.csv.
# MATTERPORT_INDEX=~/Downloads/models_index.csv
# COSTAR_DATA_DIR=~/Downloads/costar-hackathon-kit
ACCESS_SCAN_PORT=8765

# Browser Showcase SDK key (separate from private Model API credentials).
# Allow your local origin, e.g. 127.0.0.1:5175, in SDK Key Management.
MATTERPORT_SDK_KEY=
